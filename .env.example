# ═════════════════════════════════════════════════════════════════════════════
# Multi-Model Headroom Proxy v2.0 — Environment Configuration
# Copy this file to .env and fill in your API keys
# ═════════════════════════════════════════════════════════════════════════════

# ─── Proxy Settings ───────────────────────────────────────────────────────────
PROXY_PORT=3456
DEFAULT_PROVIDER=kimi

# ─── Headroom Compression Settings ────────────────────────────────────────────
# Enable/disable Headroom context compression
HEADROOM_ENABLED=true

# URL of the Headroom proxy (start with: headroom proxy --port 8787)
HEADROOM_BASE_URL=http://localhost:8787

# Headroom Cloud API key (only needed for Headroom Cloud, not local proxy)
# HEADROOM_API_KEY=hr_your_key_here

# Model name for Headroom token counting (used when not inferable from request)
HEADROOM_MODEL=gpt-4o

# Fallback to uncompressed messages if Headroom proxy fails
HEADROOM_FALLBACK=true

# Headroom request timeout (ms)
HEADROOM_TIMEOUT_MS=30000

# ─── Fallback & Retry Settings ────────────────────────────────────────────────
# Comma-separated fallback chain when primary provider fails
# e.g., try deepseek first, then glm, then openai
FALLBACK_CHAIN=deepseek,glm,openai

# Max retries per provider before moving to fallback
MAX_RETRIES=2

# Delay between retry attempts (ms)
RETRY_DELAY_MS=500

# ─── Load Balancing Settings ──────────────────────────────────────────────────
# Override load-balance groups with comma-separated provider lists
# LOADBALANCE_REASONING=deepseek,openai
# LOADBALANCE_CODING=deepseek,glm,kimi
# LOADBALANCE_GENERAL=kimi,deepseek,glm
# LOADBALANCE_VISION=openai,glm

# ─── LLM Provider API Keys ────────────────────────────────────────────────────
# Kimi (Moonshot AI) — https://platform.moonshot.cn/
KIMI_API_KEY=


# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# GLM-4 / Zhipu AI — https://api.z.ai/api/paas/v4/
GLM_API_KEY=

# OpenAI — https://platform.openai.com/
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Xiaomi / MIMO — https://token-plan-sgp.xiaomimimo.com/v1
XIAOMI_API_KEY=
