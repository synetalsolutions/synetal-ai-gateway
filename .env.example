# ═════════════════════════════════════════════════════════════════════════════
# Kestrel AI Gateway v2.5.0 — Environment Configuration
# Copy this file to .env and fill in your API keys
# ═════════════════════════════════════════════════════════════════════════════

# ─── Proxy Settings ───────────────────────────────────────────────────────────
PROXY_PORT=3456
DEFAULT_PROVIDER=kimi

# ─── Proxy Authentication ────────────────────────────────────────────────────
# Generate a secure random key:
#   openssl rand -hex 32
# Clients must send: Authorization: Bearer <PROXY_API_KEY>
PROXY_API_KEY=sk-your-secret-key-here

# ─── Fallback & Retry Settings ────────────────────────────────────────────────
# Comma-separated fallback chain when primary provider fails
FALLBACK_CHAIN=glm,deepseek,xiaomi,kimi
MAX_RETRIES=2
RETRY_DELAY_MS=500

# ─── Load Balancing Settings ──────────────────────────────────────────────────
# Override load-balance groups with comma-separated provider lists
# LOADBALANCE_REASONING=deepseek,glm,kimi,xiaomi
# LOADBALANCE_CODING=kimi,glm,deepseek,xiaomi
# LOADBALANCE_GENERAL=kimi,glm,deepseek,xiaomi
# LOADBALANCE_VISION=kimi,glm,xiaomi

# ─── LLM Provider API Keys ────────────────────────────────────────────────────
# Kimi (Moonshot AI) — https://platform.moonshot.cn/
KIMI_API_KEY=

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# GLM / Zhipu AI — https://z.ai/
GLM_API_KEY=

# Xiaomi / MiMo — https://xiaomimimo.com/
XIAOMI_API_KEY=

# ─── Cost-Aware Routing (automatic, no config needed) ─────────────────────────
# The smart router automatically scores prompt complexity and routes to the
# cheapest viable model. Circuit breaker protects against rate limits.
# These settings are built-in and require no configuration.

# ─── Context Truncation (built-in, no external dependency) ────────────────────
# The built-in context truncator saves 57-96% tokens on Cursor/Copilot traffic.
# It runs automatically — no setup needed.
